/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

// Boat frame: the undisturbed water moves at (-U_boat, 0, 0).
// inlet and bottom values are overwritten every step by the boatMotion function object.
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    surface { type slip; }
    inlet   { type fixedValue; value uniform (0 0 0); }
    outlet  { type inletOutlet; inletValue uniform (0 0 0); value uniform (0 0 0); }
    sides   { type slip; }
    bottom  { type fixedValue; value uniform (0 0 0); }
    boat    { type noSlip; }
}

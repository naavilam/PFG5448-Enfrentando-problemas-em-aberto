FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// Remove the boat volume (30 x 15 mm, 3 mm draft) from the tank
actions
(
    { name boat;  type cellSet; action new;      source boxToCell; box (-0.015 -0.0075 -0.003) (0.015 0.0075 0.001); }
    { name fluid; type cellSet; action new;      source boxToCell; box (-1 -1 -1) (1 1 1); }
    { name fluid; type cellSet; action subtract; source cellToCell; sets (boat); }
);
